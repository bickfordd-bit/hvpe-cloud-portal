# HVPE Cloud Portal - Environment Variables Template
# Copy this file to .env.local and fill in your values

# ============================================================================
# CORE CONFIGURATION (Required for all branches)
# ============================================================================

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/hvpe_cloud_portal"

# OpenAI API (for AI features)
# Preferred: Use HVPE_OPENAI_API_KEY
HVPE_OPENAI_API_KEY="sk-..."
# Fallback: OPENAI_API_KEY
# OPENAI_API_KEY="sk-..."

# Application
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================================================
# OPTIONAL CORE FEATURES
# ============================================================================

# Stripe (for license payments)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Email (for notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="HVPE Cloud Portal <noreply@hvpe.app>"

# Twilio (for SMS notifications)
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_PHONE_NUMBER="+1234567890"

# Voice-to-Code AI Assistant
AI_WEBHOOK_SECRET="your-secure-secret"
GITHUB_TOKEN="ghp_..."  # For creating PRs

# Admin Dashboard
ADMIN_DASH_TOKEN="your-admin-token"
ADMIN_APPLY_SECRET="your-apply-secret"

# Vercel Deployment (for CI/CD)
VERCEL_TOKEN="..."
VERCEL_ORG_ID="..."
VERCEL_PROJECT_ID="..."

# ============================================================================
# BRANCH-SPECIFIC CONFIGURATION
# ============================================================================

# -----------------------------------------------------------------------------
# BICKFORD BRANCH - Core AI Features
# -----------------------------------------------------------------------------
# Uncomment if working on bickford branch

# BICKFORD_MODEL="gpt-4-turbo-preview"
# BICKFORD_MAX_TOKENS="4000"
# BICKFORD_TEMPERATURE="0.7"
# BICKFORD_MEMORY_TTL="3600"  # seconds
# BICKFORD_CONTEXT_WINDOW="10"  # number of messages

# -----------------------------------------------------------------------------
# BICKFORD-MOBILE BRANCH - Mobile Application
# -----------------------------------------------------------------------------
# Uncomment if working on bickford-mobile branch

# MOBILE_API_URL="https://api.hvpe.app"
# MOBILE_PUSH_NOTIFICATION_KEY="..."
# MOBILE_APP_ID="com.hvpe.mobile"
# MOBILE_BUILD_NUMBER="1"
# MOBILE_VERSION="1.0.0"

# Expo/React Native (if applicable)
# EXPO_PUBLIC_API_URL="https://api.hvpe.app"
# EXPO_PROJECT_ID="..."

# -----------------------------------------------------------------------------
# HVPETRADER BRANCH - Trading Platform
# -----------------------------------------------------------------------------
# Uncomment if working on hvpetrader branch

# Alpaca Trading API
# ALPACA_API_KEY="PK..."
# ALPACA_SECRET_KEY="..."
# ALPACA_BASE_URL="https://paper-api.alpaca.markets"  # or live: https://api.alpaca.markets

# OPTR Trading Configuration
# OPTR_WORKER_URL="http://localhost:8787"
# OPTR_ADMIN_KEY="your-optr-admin-key"
# OPTR_MAX_NOTIONAL="50"  # max $ per order
# OPTR_MAX_NOTIONAL_PER_DAY="500"  # max $ per day
# OPTR_SYMBOL_ALLOWLIST="AAPL,MSFT,GOOGL,AMZN,TSLA"
# OPTR_ALLOW_LIVE="false"  # set to "true" to enable live trading

# Market Data
# MARKET_DATA_PROVIDER="alpaca"  # or "polygon", "iex"
# POLYGON_API_KEY="..."
# IEX_API_KEY="..."

# Trading Analytics
# TRADING_ANALYTICS_WEBHOOK="https://analytics.hvpe.app/webhook"

# -----------------------------------------------------------------------------
# BICKFORD-FOR-DEFENSE BRANCH - Defense/DoD Version
# -----------------------------------------------------------------------------
# Uncomment if working on bickford-for-defense branch

# DoD Compliance
# DOD_API_KEY="..."
# CMMC_COMPLIANCE_MODE="true"
# CLASSIFICATION_LEVEL="UNCLASSIFIED"  # or "CUI", "SECRET"
# AUDIT_LOG_RETENTION_DAYS="2555"  # 7 years for DoD

# SAM.gov Integration
# SAM_API_KEY="..."
# SAM_BASE_URL="https://api.sam.gov"

# DoD Identity Management
# DOD_IDENTITY_PROVIDER="cac"  # or "piv"
# CAC_CERT_PATH="/path/to/cac/cert"
# PIV_ENABLED="true"

# Secure Communication
# ENCRYPTED_STORAGE_KEY="..."
# SECURE_TRANSPORT="tls1.3"

# -----------------------------------------------------------------------------
# PENELOPE BRANCH - AI Content Generation
# -----------------------------------------------------------------------------
# Uncomment if working on penelope branch

# Content Generation
# PENELOPE_MODEL="gpt-4-turbo-preview"
# PENELOPE_MAX_TOKENS="8000"
# PENELOPE_TEMPERATURE="0.8"

# Content Storage
# CONTENT_STORAGE_URL="https://storage.hvpe.app"
# CONTENT_STORAGE_BUCKET="penelope-content"
# CONTENT_STORAGE_KEY="..."
# CONTENT_STORAGE_SECRET="..."

# Template Engine
# TEMPLATE_ENGINE_URL="https://templates.hvpe.app"
# TEMPLATE_API_KEY="..."

# Export Formats
# PENELOPE_ENABLE_PDF="true"
# PENELOPE_ENABLE_DOCX="true"
# PENELOPE_ENABLE_HTML="true"

# Brand Voice
# PENELOPE_BRAND_VOICE="professional"  # or "casual", "technical"

# -----------------------------------------------------------------------------
# PERSONAL BRANCHES (dad, derek-and-jenna, xavier, naomi)
# -----------------------------------------------------------------------------
# Uncomment if working on personal branches

# Personal API Keys (if needed for experiments)
# PERSONAL_API_KEY="..."
# EXPERIMENTAL_FEATURE_FLAG="true"

# Personal Database (optional, for isolated testing)
# PERSONAL_DATABASE_URL="postgresql://user:password@localhost:5432/personal_db"

# ============================================================================
# DEVELOPMENT TOOLS
# ============================================================================

# Debugging
DEBUG="false"
LOG_LEVEL="info"  # error, warn, info, debug

# Testing
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/hvpe_test"

# Performance Monitoring
# SENTRY_DSN="https://...@sentry.io/..."
# SENTRY_AUTH_TOKEN="..."

# Analytics (optional)
# NEXT_PUBLIC_GA_ID="G-..."
# NEXT_PUBLIC_MIXPANEL_TOKEN="..."

# ============================================================================
# NOTES
# ============================================================================

# 1. Never commit .env.local to git (it's in .gitignore)
# 2. Use different values for development, staging, and production
# 3. Store production secrets in Vercel/deployment platform settings
# 4. For branch-specific work, only uncomment the relevant section
# 5. See BRANCH_ARCHITECTURE.md for branch-specific requirements
# 6. Contact team leads for production API keys

# ============================================================================
# SECURITY REMINDERS
# ============================================================================

# ⚠️  DO NOT commit real secrets to git
# ⚠️  Rotate keys regularly
# ⚠️  Use different keys for dev/staging/production
# ⚠️  Enable 2FA on all service accounts
# ⚠️  Follow principle of least privilege
# ⚠️  Audit access logs regularly
