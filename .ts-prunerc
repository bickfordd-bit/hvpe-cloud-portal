{
  "comment": "NOTE: ts-prune doesn't currently support loading config from this file. This serves as documentation of ignore patterns. The auto-heal workflow duplicates these patterns inline.",
  "ignore": [
    "src/app/**/page.tsx",
    "src/app/**/layout.tsx",
    "src/app/api/**/route.ts",
    "src/app/api/**/route.native.ts",
    "middleware.ts",
    "next.config.ts",
    "jest.config.ts",
    "tailwind.config.js"
  ]
}
