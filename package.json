{
  "name": "bickford-app",
  "version": "1.0.0",
  "description": "Bickford - Intent to Reality Instantly",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "deploy": "npm run build && npm run start",
    "deploy:vercel": "vercel --prod",
    "migrate:deploy": "test -n \"$DATABASE_URL\" && prisma migrate deploy || echo 'Skipping migrations - DATABASE_URL not set'",
    "migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "postinstall": "test -n \"$DATABASE_URL\" && prisma generate || prisma generate --schema=prisma/schema.prisma || true",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prepare": "husky"
  },
  "dependencies": {
    "@bickfordd-bit/bickford": "file:packages/bickford",
    "@prisma/client": "^6.3.1",
    "expo": "^54.0.29",
    "expo-modules-autolinking": "^3.0.23",
    "expo-router": "^3.5.24",
    "expo-splash-screen": "^31.0.12",
    "expo-status-bar": "^3.0.9",
    "expo-updates": "^29.0.15",
    "googleapis": "^168.0.0",
    "lucide-react": "^0.560.0",
    "next": "16.0.7",
    "nodemailer": "^7.0.11",
    "openai": "^4.20.1",
    "pdfkit": "^0.17.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.2",
    "stripe": "^20.0.0",
    "twilio": "^5.10.7",
    "winston": "^3.11.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.4",
    "@types/pdfkit": "^0.17.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.0.7",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "prisma": "^6.3.1",
    "tailwindcss": "^4",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "main": "expo-router/entry",
  "expo-router": {
    "appRoot": "src/app"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix --quiet",
      "prettier --write"
    ],
    "*.{css,scss,json,md}": [
      "prettier --write"
    ]
  }
}
