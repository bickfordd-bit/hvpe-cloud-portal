{
  "name": "bickford-app",
  "version": "1.0.0",
  "description": "Bickford - Intent to Reality Instantly",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "deploy": "npm run build && npm run start",
    "deploy:vercel": "vercel --prod",
    "migrate:deploy": "test -n \"$DATABASE_URL\" && prisma migrate deploy || echo 'Skipping migrations - DATABASE_URL not set'",
    "postinstall": "test -n \"$DATABASE_URL\" && prisma generate || prisma generate --schema=prisma/schema.prisma || true"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "googleapis": "^168.0.0",
    "lucide-react": "^0.560.0",
    "next": "16.0.7",
    "nodemailer": "^7.0.11",
    "openai": "^6.10.0",
    "pdfkit": "^0.17.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "stripe": "^20.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.4",
    "@types/pdfkit": "^0.17.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.0.7",
    "prisma": "^6.3.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
