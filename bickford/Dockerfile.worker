FROM node:20-alpine AS base

# Install dependencies
FROM base AS deps
WORKDIR /app

# Copy workspace configuration
COPY package*.json ./
COPY apps/worker/package*.json ./apps/worker/
COPY packages/shared/package*.json ./packages/shared/

# Install dependencies
RUN npm ci

# Build
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Build shared package
WORKDIR /app/packages/shared
RUN npm run build

# Build worker
WORKDIR /app/apps/worker
RUN npm run build

# Production
FROM base AS runner
WORKDIR /app

ENV NODE_ENV production

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 workeruser

# Copy built files
COPY --from=builder --chown=workeruser:nodejs /app/apps/worker/dist ./dist
COPY --from=builder --chown=workeruser:nodejs /app/apps/worker/node_modules ./node_modules
COPY --from=builder --chown=workeruser:nodejs /app/packages/shared/dist ./shared

USER workeruser

CMD ["node", "dist/index.js"]
