{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "regions": ["iad1"],
  "env": {
    "NEXT_TELEMETRY_DISABLED": "1",
    "SKIP_ENV_VALIDATION": "1",
    "CHECKPOINT_DISABLE": "1"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Bickford-Protection",
          "value": "Proprietary Technology - All Rights Reserved"
        },
        {
          "key": "X-Patent-Status",
          "value": "Patent Pending - US Provisional Patent Application Filed"
        }
      ]
    }
  ],
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30,
      "memory": 1024
    },
    "api/**/*.js": {
      "maxDuration": 30,
      "memory": 1024
    }
  }
}