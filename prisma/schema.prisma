generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model LicenseRequest {
  id         String               @id @default(cuid())
  email      String
  name       String?
  reason     String?
  status     LicenseRequestStatus @default(PENDING)
  createdAt  DateTime             @default(now())
  approvedAt DateTime?
  licenseId  String?
  license    License?             @relation(fields: [licenseId], references: [id])
}

model License {
  id          String           @id @default(cuid())
  key         String           @unique
  email       String
  status      LicenseStatus    @default(ACTIVE)
  createdAt   DateTime         @default(now())
  activatedAt DateTime?
  requests    LicenseRequest[]
}

model AiUsageLog {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  tenantId         String?
  userId           String?
  mode             String?
  taskType         String?
  model            String?
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  latencyMs        Int?
  success          Boolean  @default(true)
  errorMessage     String?
}

model Embedding {
  id        String   @id @default(cuid())
  docId     String
  optrId    String?
  vector    Json
  snippet   String?
  createdAt DateTime @default(now())
}

model AIPatchLog {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  userId      String?
  instruction String
  patch       String
  applied     Boolean   @default(false)
  branch      String?
  prUrl       String?
  approvedBy  String?
  approvedAt  DateTime?
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String?
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  lastLoginAt  DateTime?
  apiKeys      APIKey[]
  auditLogs    AuditLog[]

  @@index([email])
}

model APIKey {
  id         String       @id @default(cuid())
  userId     String
  name       String
  keyHash    String       @unique
  scopes     String[] // e.g. ["bickford:chat", "optr:run"]
  status     APIKeyStatus @default(ACTIVE)
  createdAt  DateTime     @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyHash])
}

model Opportunity {
  id          String            @id
  source      String
  title       String
  agency      String
  naics       String?
  psc         String?
  deadlineIso String
  links       String[] // Array of URLs
  metadata    Json? // Store additional data
  status      OpportunityStatus @default(ACTIVE)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  documents OpportunityDocument[]
  runs      OpportunityRun[]

  @@index([agency])
  @@index([deadlineIso])
  @@index([status])
}

model OpportunityDocument {
  id            String   @id @default(cuid())
  opportunityId String
  type          String // pdf, docx, html, text
  sha256        String
  filename      String
  content       String?  @db.Text
  url           String?
  createdAt     DateTime @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
  @@index([sha256])
}

model OpportunityRun {
  id            String   @id @default(cuid())
  opportunityId String
  phase         String // I, D, M, V, O, S, HALT
  blocked       Boolean
  coverage      Float
  winProb       Float
  ecv           Int
  traces        Json // Store full trace array
  metadata      Json? // Store requirements and other data
  createdAt     DateTime @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String // e.g. "login", "optr.run", "api.call"
  resource  String? // e.g. "opportunity:123"
  metadata  Json? // Additional context
  ipAddress String?
  userAgent String?
  status    String // "success", "failure"
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

enum LicenseRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LicenseStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum UserRole {
  USER
  ADMIN
  SUPERADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum APIKeyStatus {
  ACTIVE
  REVOKED
}

enum OpportunityStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

model T2VDelta {
  id            String    @id @default(cuid())
  accountId     String
  engagementId  String?
  baselineValue Float
  improvedValue Float?
  improvedAt    DateTime?
  unit          String?
  source        String?
  confidence    Float?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([accountId])
  @@index([engagementId])
  @@index([updatedAt])
}

model DefensibilitySnapshot {
  id               String   @id @default(cuid())
  accountId        String
  stream           String?
  durabilityLever  Float
  wildcardLever    Float
  alignmentLever   Float
  scalabilityLever Float
  score            Float
  multiple         Float
  notes            String?
  createdAt        DateTime @default(now())

  @@index([accountId])
  @@index([stream])
  @@index([createdAt])
}
