# OPTR Trade Worker Environment Variables

# Shared authentication key between Next.js API and Python worker
OPTR_ADMIN_KEY=your-secret-key-here

# Alpaca Trading API credentials
ALPACA_API_KEY=your-alpaca-api-key
ALPACA_API_SECRET=your-alpaca-api-secret

# Alpaca API endpoint (paper trading by default)
# For live trading, use: https://api.alpaca.markets
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Optional: Worker HTTP server port
OPTR_WORKER_PORT=8787
