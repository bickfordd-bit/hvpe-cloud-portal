apiVersion: v1
kind: Secret
metadata:
  name: hvpe-secrets
  namespace: default
type: Opaque
stringData:
  openai-api-key: "sk-proj-YOUR_KEY_HERE"
  database-url: "postgresql://user:password@postgres:5432/hvpe"
  nextauth-secret: "generate-with-openssl-rand-base64-32"
  admin-dash-token: "generate-secure-token"
  stripe-secret-key: "sk_test_YOUR_STRIPE_KEY"
